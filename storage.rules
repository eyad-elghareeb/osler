rules_version = '2';

// =============================================================================
// Osler V2 Firebase Storage Rules (Phase 9)
// -----------------------------------------------------------------------------
// Used for optional cloud-based content pack sharing. Users export a pack
// to Cloud Storage, get a URL, and share it. Recipients download without
// needing to be signed in.
//
// The bucket is NEVER used for:
//   - Admin-managed content (lives in /content/ in the repo)
//   - User custom content (lives in Firestore at userContent/{uid}/items/)
//   - Site assets (bundled into the site at generation time)
//
// Deploy:
//   firebase deploy --only storage:rules
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ───────────────────────────────────────────────────────────────────────
    // User content packs (V2)
    // Path: userContent/{uid}/{fileName}
    //
    // Owner-only read/write. Plus optional public read for files the owner
    // has marked sharePublic = 'true' via custom metadata.
    // ───────────────────────────────────────────────────────────────────────
    match /userContent/{uid}/{fileName} {

      // Owner-only write, with size + content-type limits
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024  // 50 MB max
        && request.resource.contentType.matches('application/json');

      // Owner read OR public read (if sharePublic metadata is 'true')
      allow read: if (request.auth != null && request.auth.uid == uid)
        || resource.metadata.sharePublic == 'true';
    }

    // ───────────────────────────────────────────────────────────────────────
    // Default: deny everything else
    // ───────────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
