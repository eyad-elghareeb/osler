{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osler.app/schemas/flashcard-v1.json",
  "title": "Flashcard Content",
  "type": "object",
  "required": ["meta", "type", "cards"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["uid", "title", "schemaVersion", "createdAt", "updatedAt"],
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "type": { "type": "string", "pattern": "^flashcard$" },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "front", "back"],
        "properties": {
          "id": { "type": "string" },
          "front": { "type": "string" },
          "back": { "type": "string" },
          "cloze": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
