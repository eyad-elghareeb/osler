{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osler.app/schemas/hub-v1.json",
  "title": "Hub (Content Manifest) Content",
  "type": "object",
  "required": ["meta", "type", "items"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["uid", "title", "schemaVersion", "createdAt", "updatedAt"],
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "type": { "type": "string", "pattern": "^hub$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uid", "type", "title", "path"],
        "properties": {
          "uid": { "type": "string" },
          "type": { "type": "string", "enum": ["quiz", "bank", "flashcard", "written", "osce", "hub"] },
          "title": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
