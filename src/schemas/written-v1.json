{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osler.app/schemas/written-v1.json",
  "title": "Written Assessment Content",
  "type": "object",
  "required": ["meta", "type", "prompts"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["uid", "title", "schemaVersion", "createdAt", "updatedAt"],
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "type": { "type": "string", "pattern": "^written$" },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "rubric": { "type": "array", "items": { "type": "string" } },
          "wordLimit": { "type": "integer", "minimum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
