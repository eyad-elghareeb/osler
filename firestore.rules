rules_version = '2';

// =============================================================================
// Osler V2 Firestore Security Rules (Phase 9)
// -----------------------------------------------------------------------------
// Owner-only access to user data. The rules enforce:
//   - users/{uid}/trackers/*         — owner-only read/write  (V1, preserved)
//   - users/{uid}/streaks/*          — owner-only read/write  (V1, preserved)
//   - userContent/{uid}/items/{itemId} — owner-only read/write (V2 new)
//   - events/{eventId}               — authenticated create-only (V1, preserved)
//
// Default deny covers everything else.
//
// Deploy:
//   firebase deploy --only firestore:rules
// Or paste into Firebase console → Firestore Database → Rules → Publish.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────────
    // User trackers (V1, preserved)
    // Per-type study progress: quiz, bank, flashcard, written, osce.
    // Path: users/{uid}/trackers/{type}/{itemId}
    // ───────────────────────────────────────────────────────────────────────
    match /users/{uid}/trackers/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ───────────────────────────────────────────────────────────────────────
    // User streaks (V1, preserved)
    // Path: users/{uid}/streaks/{type}
    // ───────────────────────────────────────────────────────────────────────
    match /users/{uid}/streaks/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ───────────────────────────────────────────────────────────────────────
    // User custom content (V2 new — Phase 9)
    // Path: userContent/{uid}/items/{itemId}
    //
    // Owner-only read/write. A user can read and write their own custom
    // content but cannot see anyone else's.
    //
    // Schema validation is deferred to client-side src/lib/validate.js.
    // Server-side validation is documented in
    // docs/firebase/firestore-rules.md as a defense-in-depth option
    // (uncomment after P9.2 security review).
    // ───────────────────────────────────────────────────────────────────────
    match /userContent/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Defense-in-depth schema validation (optional — P9.2 will enable
      // after security review). Uncomment to require known schemaVersion.
      //
      // allow write: if request.auth != null
      //   && request.auth.uid == uid
      //   && request.resource.data.meta.schemaVersion in ['1.0'];
    }

    // ───────────────────────────────────────────────────────────────────────
    // Analytics events (V1, preserved)
    // Append-only: authenticated users can create, no one can read.
    // Aggregation done server-side via the admin dashboard (service account).
    // ───────────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // ───────────────────────────────────────────────────────────────────────
    // Default: deny everything else
    // ───────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
