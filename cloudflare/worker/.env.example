# Osler Cloud Worker — Environment Variables & Secrets Reference
# Copy this file to .dev.vars for local development with `wrangler dev`.

# Web Crypto JWT secret for HMAC-SHA-256 session signing.
# Generate a long random secret: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Public origin of the web application allowed for CORS.
ALLOWED_ORIGIN=http://localhost:3000

# Public URL of the Worker (required for Google OAuth callback handoffs).
WORKER_URL=http://localhost:8787

# Optional: Cloudflare Turnstile secret key (set TURNSTILE_ENABLED=true in wrangler.toml)
TURNSTILE_SECRET_KEY=

# Optional: Resend API key for password-reset emails
RESEND_API_KEY=
EMAIL_FROM=Osler <noreply@example.com>
APP_ORIGIN=http://localhost:3000

# Optional: Google OAuth 2.0 Credentials for Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
