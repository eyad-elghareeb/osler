    "@cloudflare/workers-types": "^5.20260902.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1"
  }
