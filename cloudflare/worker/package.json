{
  "name": "osler-cloud-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "db:migrate:local": "wrangler d1 migrations apply osler-cloud --local",
