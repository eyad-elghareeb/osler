# Cloudflare Pages headers.
#
# Applied to all responses unless overridden by a more specific block.
# Static assets under /_next/static/ get long-lived immutable caching
# because Next.js content-hashes them.

# ── Long-lived immutable cache for hashed static assets ──
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ── Block directory listing via robots for private dirs ──
/docs/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# ── Fonts & icons — long cache, but revalidate occasionally ──
/fonts/*
  Cache-Control: public, max-age=2592000
/assets/*
  Cache-Control: public, max-age=2592000

# ── Local content packs — short cache, network-first via SW ──
# When a ?v= content-version is present the URL is effectively immutable
# (new publishes get a new stamp), so SW + CDN can hold it long. Without
# ?v= we still serve stale-while-revalidate so a slow revalidate never
# blocks first paint and offline cache wins via SW NetworkFirst.
/osler-content/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# ── Content version & site config — never cache at edge/browser cache ──
# Polling with `cache: no-store` bypasses the browser cache, but edge
# (Pages) would still cache without these headers. Kept tiny; must be fresh.
/osler-content/content-version.json
  Cache-Control: no-cache, no-store, must-revalidate
/osler.config.json
  Cache-Control: public, max-age=60, must-revalidate

# ── Service worker — NEVER cache (always fetch fresh) ──
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ── SW sourcemap — dev only, never cache in prod ──
/sw.js.map
  Cache-Control: no-store

# ── Manifest — short cache ──
/manifest.webmanifest
  Cache-Control: public, max-age=300
  Content-Type: application/manifest+json; charset=utf-8

# ── Security headers (applied to ALL responses) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # camera/microphone must be (self) — the app legitimately uses them
  # (OSCE voice mode, written-answer photo capture). An empty allowlist ()
  # disables the feature for the whole origin, so getUserMedia fails with
  # NotAllowedError and Chrome never shows the permission prompt.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), browsing-topics=(), join-ad-interest-group=(), run-ad-auction=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy.
  #
  # Notes on the allowances (each is required by the app):
  #  · script-src 'unsafe-inline'  — Next.js static export injects inline RSC
  #    hydration scripts; static export has no server to mint nonces.
  #  · script-src 'unsafe-eval'    — the Mermaid renderer uses the Function
  #    constructor (library diagrams + admin editor). Dropping mermaid support
  #    would let you remove it.
  #  · connect-src *.workers.dev   — the Worker backend (cloud.apiUrl). If you
  #    put the Worker on a CUSTOM domain, add that origin here.
  #  · connect-src wss://0.peerjs.com / wss://broker.emqx.io — P2P sync
  #    (PeerJS signaling + MQTT relay).
  #  · connect-src generativelanguage.googleapis.com — AI assistant (REST + WS).
  #  · frame-src https:  — YouTube + Invidious video embeds (Invidious host is
  #    configurable via NEXT_PUBLIC_INVIDIOUS_HOST, so a scheme source is used).
  #    Tighten to your fixed hosts once they are stable.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.workers.dev https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com https://challenges.cloudflare.com https://0.peerjs.com wss://0.peerjs.com wss://broker.emqx.io:8084; media-src 'self' blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
