# Osler Web Application — Environment Variables Template
# Copy this file to .env.local for local environment overrides.

# Alternative YouTube frontend host for the "pipe via alternative host" button in the video player.
# Bundled at build time via NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_INVIDIOUS_HOST=invidious.tiekoetter.com

# Optional Cloudflare Worker backend API URL override.
# Can also be set in public/osler.config.json under "cloud.apiUrl".
# NEXT_PUBLIC_CLOUD_API_URL=https://osler-cloud.example.workers.dev
